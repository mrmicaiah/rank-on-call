{
  "name": "rank-on-call-fulfillment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stripe webhook + durable job record + queue enqueue for Rank On Call fulfillment. Deliberately separate from the root 11ty package.",
  "scripts": {
    "test": "node --test src/*.test.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute roc-fulfillment --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute roc-fulfillment --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
